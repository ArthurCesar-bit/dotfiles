# ─────────────────────────────────────────────────────────────────────────────
#  Ghostty — tema "Nocturne" (dark)
#  ~/.config/ghostty -> ~/dotfiles/ghostty
#
#  LEADER = CTRL+Space
#
#  Splits   LEADER | / LEADER -     dividir horizontal / vertical
#           LEADER h j k l          navegar
#           LEADER z  zoom          LEADER x  fechar
#           LEADER r  modo resize (hjkl, Esc sai)
#  Abas     LEADER c  nova          LEADER n / p  próxima / anterior
#           ALT+1..9  ir para aba
#  Extras   CTRL+SHIFT+P  paleta de comandos
#           LEADER b  transparência (on/off)
# ─────────────────────────────────────────────────────────────────────────────

##### tipografia ##############################################################
font-family = JetBrainsMono Nerd Font
font-family-bold = JetBrainsMono Nerd Font
font-family-italic = JetBrainsMono Nerd Font
font-family-bold-italic = JetBrainsMono Nerd Font
font-style-bold = Bold
font-style-italic = Italic
font-size = 13.5
font-thicken = false

# line_height 1.15 do WezTerm
adjust-cell-height = 15%

font-feature = calt
font-feature = clig
font-feature = liga

##### cores ###################################################################
theme = nocturne
bold-is-bright = true

##### janela ##################################################################
window-decoration = auto
window-padding-x = 14,12
window-padding-y = 10,8
window-padding-balance = false
window-width = 120
window-height = 32
window-theme = ghostty
window-inherit-working-directory = true
window-inherit-font-size = true
background-opacity = 1.0

# painel inativo esmaecido (inactive_pane_hsb do WezTerm)
unfocused-split-opacity = 0.68

##### abas ####################################################################
gtk-tabs-location = top
gtk-wide-tabs = false
gtk-single-instance = true
adw-toolbar-style = flat

##### cursor ##################################################################
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

##### scrollback / mouse ######################################################
scrollback-limit = 52428800
mouse-hide-while-typing = true
copy-on-select = clipboard
clipboard-trim-trailing-spaces = true
link-url = true

##### diversos ################################################################
confirm-close-surface = true
window-save-state = never
resize-overlay = never
auto-update = off

##### teclas ##################################################################
# --- leader CTRL+Space (sequências) ---
# manda um CTRL+Space literal (NUL) quando precisar
keybind = ctrl+space>ctrl+space=text:\x00

# splits
keybind = ctrl+space>shift+backslash=new_split:right
keybind = ctrl+space>minus=new_split:down
keybind = ctrl+space>h=goto_split:left
keybind = ctrl+space>j=goto_split:down
keybind = ctrl+space>k=goto_split:up
keybind = ctrl+space>l=goto_split:right
keybind = ctrl+space>z=toggle_split_zoom
keybind = ctrl+space>x=close_surface

# resize (repetível com ctrl+hjkl dentro da sequência)
keybind = ctrl+space>ctrl+h=resize_split:left,10
keybind = ctrl+space>ctrl+j=resize_split:down,10
keybind = ctrl+space>ctrl+k=resize_split:up,10
keybind = ctrl+space>ctrl+l=resize_split:right,10
keybind = ctrl+space>equal=equalize_splits

# abas
keybind = ctrl+space>c=new_tab
keybind = ctrl+space>n=next_tab
keybind = ctrl+space>p=previous_tab

# extras
keybind = ctrl+space>b=toggle_background_opacity
keybind = ctrl+space>comma=prompt_surface_title

# --- atalhos diretos (mesmos do WezTerm) ---
keybind = ctrl+shift+d=new_split:right
keybind = ctrl+shift+e=new_split:down
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+right=goto_split:right

keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab

keybind = ctrl+shift+p=toggle_command_palette
keybind = ctrl+shift+k=clear_screen

keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size

# ALT+1..9 salta direto para a aba
keybind = alt+one=goto_tab:1
keybind = alt+two=goto_tab:2
keybind = alt+three=goto_tab:3
keybind = alt+four=goto_tab:4
keybind = alt+five=goto_tab:5
keybind = alt+six=goto_tab:6
keybind = alt+seven=goto_tab:7
keybind = alt+eight=goto_tab:8
keybind = alt+nine=goto_tab:9
